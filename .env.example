# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: bypasses RLS, used by API routes to write and broadcast
SUPABASE_SERVICE_ROLE_KEY=

# Signs the anonymous `cid` cookie used for rate limiting (any long random string)
CID_SECRET=
# Password for /admin: at least 16 characters, or nobody can log in. Generate one with
# `openssl rand -base64 24`
ADMIN_PASSWORD=

# Projector key (spec 3.5): open /?key=<SCREEN_KEY> once on the projector to get the 48-hour `screen`
# cookie that turns on Realtime and the danmaku layer. Any long random string; share it only with
# whoever runs the projector. Server only. Changing it and redeploying signs out every projector.
SCREEN_KEY=

# Public URL of the site, used for the danmaku QR code (e.g. https://xxx.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 1 = hooks return fake data, no Supabase needed (frontend development)
NEXT_PUBLIC_USE_MOCK=1
